PORT=3001
JWT_SECRET=your-secret
NODE_ENV=production

# Production (Railway) — paste full service account JSON as one line
FIREBASE_CONFIG={"type":"service_account","project_id":"localbite-d8cc0"}

# Local dev only — path to JSON key file (do not use on Railway)
# FIREBASE_SERVICE_ACCOUNT_PATH=./localbite-d8cc0-firebase-adminsdk-xxxxx.json

# Optional local LAN URL for photo proxy links
# API_PUBLIC_URL=http://192.168.254.107:3001

# Unsplash (optional — npm run seed:food)
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
